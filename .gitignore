# 비밀키 — 절대 커밋 금지
wallets/
*.keypair.json
.env
web/.env
web/.env.local

# 런타임 상태 (봇·영수증·포지션 복원용). 비밀은 없지만 환경마다 다르다.
state/

# 파이썬 부산물
__pycache__/
*.pyc

# provider.yml 은 제외하지 않는다.
# 비밀이 없고(이름·subdomain·forward_url·가격표뿐) 판매 게이트웨이 설계를
# 보여주는 제출 자산이다. 예전에 setup_wallets.py 가 자동으로 여기 넣었다.

# 배포용 비밀 묶음 — 개인키가 들어 있다. 절대 커밋 금지.
deploy/secrets.tar.gz
deploy/_stage/

# 프론트 빌드 산출물. Docker 가 직접 빌드하므로 저장소에 둘 이유가 없다.
web/dist/

# 발표 자료 — deploy/make_deck.py 로 언제든 다시 만든다.
# 사업 내용(타깃·수익모델)이라 공개 저장소에 올릴지는 그때 정한다.
Cognitive-Economy-*.pptx
~$*.pptx
